# Kooka Pictura environment variables (example).
#
# This file is a committed reference of every environment variable the project
# uses. It enables nothing as-is: every value is commented out. Copy it to the
# user-global location and uncomment the values you want:
#
#   mkdir -p ~/.config/kooka-pictura
#   cp .env.example ~/.config/kooka-pictura/env
#
# The real file lives outside the repository and is never committed; .gitignore
# ignores repo-local .env files so the settings cannot be forced on others.
# See DEVELOPING.md, "Speeding up local builds".

# --- Project opt-ins ---------------------------------------------------------

# Share the sccache C++ compiler cache across git worktrees (1 = on, unset = off).
# The .githooks/post-checkout hook reads it from the process environment or from
# this file.
# KOOKA_SCCACHE_SHARE=1

# Serialize heavy local verification across worktrees (1 = on, unset = off).
# scripts/verify-fast.sh and scripts/verify-full.sh read it from the process
# environment or from this file. Off by default.
# PICTURA_VERIFY_LOCK=1

# Seconds to wait for the verification lock before failing
# (default 3600; 0 = wait without a limit).
# PICTURA_VERIFY_LOCK_TIMEOUT=3600

# Override the location of this env file
# (default: ${XDG_CONFIG_HOME:-$HOME/.config}/kooka-pictura/env). Mostly for
# tests and unusual setups.
# KOOKA_ENV_FILE=~/.config/kooka-pictura/env

# --- External build knobs (set in your shell; not read from this file) -------

# Route Rust compilation through sccache.
# RUSTC_WRAPPER=sccache

# Parallel CTest level used by scripts/test-report.sh and the CI headless job
# (default 4).
# CTEST_PARALLEL_LEVEL=4

# Base for the FetchContent checkout cache used by the local build-caching
# check (default ${XDG_CACHE_HOME:-$HOME/.cache}/kooka-pictura/fetchcontent).
# XDG_CACHE_HOME=~/.cache

# sccache cache location and size cap (default ~/.cache/sccache, 10 GiB).
# SCCACHE_DIR=~/.cache/sccache
# SCCACHE_CACHE_SIZE=20G

# Let a build proceed if the sccache server is unreachable.
# SCCACHE_IGNORE_SERVER_IO_ERROR=1
